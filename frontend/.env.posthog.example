# PostHog Configuration
# Required environment variables for PostHog analytics

# PostHog API key (starts with phc_)
# Get from: https://us.posthog.com/project/<project-id>/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here

# PostHog API host (US region)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog project ID (for reference only, not used in client config)
# Project: manage-365 (ID: 686171)
POSTHOG_PROJECT_ID=686171

# Organization: cortalis
# Project: manage-365

# Privacy Settings (configured in code):
# - autocapture: disabled
# - session_recording: disabled by default
# - person_profiles: identified_only (no profiles for anonymous users)
# - All email, name, username, tenant data filtered out
# - Development mode: opted out by default
