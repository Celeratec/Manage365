# Sentry Configuration
# Required environment variables for Sentry error tracking

# Sentry DSN (Data Source Name) - get from Sentry project settings
# Client-side (public, included in browser bundle)
NEXT_PUBLIC_SENTRY_DSN=https://example@o<org-id>.ingest.us.sentry.io/<project-id>

# Server-side DSN (same as above for typical setup)
SENTRY_DSN=https://example@o<org-id>.ingest.us.sentry.io/<project-id>

# Sentry organization slug (required for builds)
SENTRY_ORG=cortalis

# Sentry project slug (required for builds)
SENTRY_PROJECT=manage-365

# Optional: Sentry environment (defaults to NODE_ENV if not set)
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Optional: Sentry auth token for uploading source maps during build
# Get from: https://sentry.io/settings/account/api/auth-tokens/
# SENTRY_AUTH_TOKEN=your-auth-token-here
